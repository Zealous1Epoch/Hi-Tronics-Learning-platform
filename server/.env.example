# Hi-Tronics 在线学习平台 · 环境变量模板
# 用法：cp .env.example .env 后填入真实值。.env 已被 .gitignore 排除，切勿提交。

# ── 数据库 ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hitronics_learning

# ── JWT ──
# 生产环境必须改为随机长字符串，否则应用启动时会直接退出
JWT_SECRET=change-me-in-production

# ── 运行模式 ──
# false = 生产模式：会强制校验 JWT_SECRET 与 ADMIN_PASSWORD
DEBUG=false

# ── 内置管理员 ──
ADMIN_USERNAME=hitronics
# 生产环境必填，否则应用启动时会直接退出
ADMIN_PASSWORD=

# ── CORS 允许来源（逗号分隔，生产环境填写实际域名）──
CORS_ORIGINS=https://your-domain.example.com

# ── 企业微信 OAuth（可留空，留空则企微登录/扫码签到不可用）──
WECHAT_CORP_ID=
WECHAT_AGENT_ID=
WECHAT_SECRET=
# 是否允许企微回调跳过 state(CSRF) 校验。默认 false（安全）。
# 仅当需要支持「企微客户端内直接打开应用」时才设为 true。
WECHAT_ALLOW_UNVERIFIED_STATE=false
#
# ⚠️ 扫码签到（投屏二维码）前置条件：
# 1) 本项（CorpID / AgentID / Secret）必须填齐；
# 2) 企业微信「我的企业 → 企业信息 → 企业微信可信域名」必须配置为下方 FRONTEND_URL 的域名，
#    并下载校验文件放到该域名根路径（如 https://<域名>/WW_verify_xxxx.txt）；
# 3) FRONTEND_URL 必须是 https（企业微信网页授权强制 https），
#    例如 https://hr.hi-tronics.com/learning-platform；
# 4) 学员需在企业微信内扫码（网页授权仅在企业微信内生效）。

# ── 阿里云 OSS（视频存储）──
# 建议使用 RAM 子账号并配合 STS 临时凭证，不要使用主账号长期密钥
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=https://oss-cn-guangzhou.aliyuncs.com
OSS_BUCKET=hitronics-learning-platform

# ── SSO 单点登录 ──
# 后端签发完 code 后跳转的前端地址
FRONTEND_URL=http://localhost:5178/learning-platform
# 票据时间窗（秒），允许的时钟偏移
SSO_TIME_WINDOW=30
# 共享密钥：配置后 OA 免密登录使用 HMAC-SHA256(secret, "工号:YYYY-MM-DD HH:MM:SS")。
# 留空会回退到不安全的 md5(时间戳) 兼容模式（任何人可自行伪造任意工号的票据）。
# 强烈建议配置，并同步修改 OA 侧签名算法。
SSO_SHARED_SECRET=

# ── OA 系统 API（接入 SSO 免密登录时填写）──
OA_API_BASE_URL=
OA_SYSTEM_ID=
OA_PASSWORD=
